# ==========================================================
# Agro AI Scheme — Environment Configuration (.env.example)
# ==========================================================

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database
# Production uses PostgreSQL 16 + PostGIS + pgvector:
# DATABASE_URL="postgresql://agro:agro_dev_password@localhost:5432/agro_ai_scheme?schema=public"
# Local Zero-Docker fallback uses SQLite via Prisma:
DATABASE_URL="file:./dev.db"

# Redis (optional in local fallback mode; required for BullMQ production worker)
REDIS_URL="redis://localhost:6379"
USE_IN_MEMORY_QUEUE="true"

# Auth & Security (Change in production!)
JWT_ACCESS_SECRET="agro_dev_access_secret_minimum_32_characters_long_012345"
JWT_REFRESH_SECRET="agro_dev_refresh_secret_minimum_32_characters_long_012345"
CSRF_SECRET="agro_dev_csrf_secret_minimum_32_characters_long_012345"
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CORS_ORIGINS="http://localhost:3000"

# Object Storage (MinIO / S3 / R2)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="agro-vault-private"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Provider Adapters (Mock by default until real credentials configured)
SMS_PROVIDER="mock"
EMAIL_PROVIDER="mock"
LLM_PROVIDER="openai"
STT_PROVIDER="web_speech"
TTS_PROVIDER="web_speech"
OCR_PROVIDER="mock"
WHATSAPP_PROVIDER="mock"

# Server-Side OpenAI API Configuration (Never exposed to browser/client)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Mandi / Market Price API Key (Server-Side)
MANDI_API_KEY=""

# WhatsApp Business Cloud API Configuration (Enabled only when approved & configured)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET="agro_dev_whatsapp_app_secret_012345"
WHATSAPP_VERIFY_TOKEN="agro_dev_whatsapp_verify_token"
